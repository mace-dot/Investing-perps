# Copy to .env.local. Never commit real keys.
# Live mode turns on only when SUPABASE_PROJECT_NAME is exactly "investing perps".
# Any URL or name containing "favos" is refused. Do not point this app at the Favos project.

# Must be the display name of the new Supabase project: investing perps
SUPABASE_PROJECT_NAME=investing perps
# Same name, exposed so the browser client can refuse any other project.
NEXT_PUBLIC_SUPABASE_PROJECT_NAME=investing perps

# Project Settings → Data API → Project URL for the investing perps project only.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable or anon key. Safe for the browser. Not the service role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy name accepted if the publishable key variable is empty.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses row level security. Never use NEXT_PUBLIC_ on this.
# Used later for account deletion. Scoring uses the signed-in user's call to submit_my_attempt.
SUPABASE_SERVICE_ROLE_KEY=

# Optional direct Postgres URL for the investing perps project. Server only.
SUPABASE_DB_URL=

# OpenAI-compatible chat endpoint. Defaults to the Vercel AI Gateway.
# Leave AI_API_KEY empty to keep canonical lesson feedback.
AI_API_KEY=
AI_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_MODEL=openai/gpt-4.1-mini
AI_TIMEOUT_MS=8000
# Per-identity cap on AI routes. The in-process limiter is per server instance.
# Shared limits belong in private.rate_limits once the investing perps database is linked.
AI_DAILY_LIMIT_PER_USER=30
